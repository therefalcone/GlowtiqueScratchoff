# Postgres connection string (Supabase: Project Settings -> Database -> Connection string, pooled).
# Used server-side only, for the reward engine's transactions and migrations.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/glowtique

# Supabase project (staff auth + RLS-guarded reads). Phase 2+.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL for card and wallet links (custom domain). When unset, links
# are built from the request host, which works locally and on Vercel.
NEXT_PUBLIC_APP_URL=

# Optional external booking link ("Book now" buttons). Hidden when unset.
NEXT_PUBLIC_BOOKING_URL=
# Optional PEM CA certificate for strict TLS verification of DATABASE_URL (Supabase: Connect → SSL certificate).
DATABASE_CA_CERT=
